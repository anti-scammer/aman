# Copy to .env next to docker-compose.yml, then edit.
#   cp .env.docker.example .env

# ---- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=antiscammer
POSTGRES_DB=antiscammer
# Required. Generate one with: openssl rand -hex 16
POSTGRES_PASSWORD=

# ---- Moderation -----------------------------------------------------------
# Required, minimum 16 characters. Without it the /api/admin routes stay
# disabled and submitted community reports can never be approved.
# Generate one with: openssl rand -hex 24
ADMIN_TOKEN=

# ---- Optional -------------------------------------------------------------
# Host port for the web app (http://localhost:<WEB_PORT>)
WEB_PORT=8080

# Seed awareness articles, quiz questions, and sample reports on first boot.
# Set to false once the database holds real data — seeding is not idempotent
# for reports.
SEED_ON_START=true

# Local-LLM second opinion (Ollama). Off by default in Docker because Ollama
# normally runs on the host, not in this network.
LLM_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
