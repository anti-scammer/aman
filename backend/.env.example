# Anti-Scammer backend — environment variables (all optional).
# Note: the app reads these from the process environment (no dotenv loader);
# export them in your shell or via your process manager, e.g.:
#   OLLAMA_MODEL=qwen2.5:3b npm run dev

# HTTP port (default 3000)
PORT=3000

# ---- Optional local-LLM analysis layer (Ollama) ---------------------------
# Base URL of the Ollama server
OLLAMA_URL=http://localhost:11434

# Model used for the second-opinion classification.
# "llama3.2" is the default; "qwen2.5:3b" handles Arabic noticeably better:
#   ollama pull qwen2.5:3b
#   OLLAMA_MODEL=qwen2.5:3b
OLLAMA_MODEL=llama3.2

# "auto" (default): probe {OLLAMA_URL}/api/tags (~1s timeout, cached 60s)
# and use the LLM only when reachable. "true"/"false" force it on/off.
LLM_ENABLED=auto
