{
  "name": "antiscammer-backend",
  "version": "1.0.0",
  "description": "Backend for the Palestinian User Protection Platform from Digital Fraud",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:seed": "tsc -p tsconfig.seed.json",
    "start": "node dist/index.js",
    "seed": "tsx prisma/seed.ts",
    "seed:prod": "node dist-seed/prisma/seed.js",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "prisma": "^5.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
